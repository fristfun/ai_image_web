APP_NAME=AI Image API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_image
JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
OPENAI_API_KEY=sk-xxx
IMAGE_MODEL_DEFAULT=gpt-image-2
IMAGE_MODEL_ALLOWLIST=gpt-image-2
LOCAL_STORAGE_DIR=uploads
BILLING_COST_MULTIPLIER=2
OPENAI_IMAGE_INPUT_TEXT_USD_PER_1M=5
OPENAI_IMAGE_INPUT_IMAGE_USD_PER_1M=10
OPENAI_IMAGE_OUTPUT_TEXT_USD_PER_1M=20
OPENAI_IMAGE_OUTPUT_IMAGE_USD_PER_1M=40
